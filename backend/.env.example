# ==========================================
# DevAdmin Backend — Production Configuration
# Copy to .env and fill in all REQUIRED values.
# ==========================================

# ---------------------------------------------------------------------------
# REQUIRED — Django Core
# ---------------------------------------------------------------------------

DEBUG=False

# Generate a strong key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of allowed host headers. Include your domain.
ALLOWED_HOSTS=admin.logicbyroshan.in,localhost

# ---------------------------------------------------------------------------
# REQUIRED — Database (MySQL)
# When running in Docker, DB_HOST must be the Docker service/container name,
# NOT 127.0.0.1 (which would point to the container itself).
# ---------------------------------------------------------------------------

USE_MYSQL=True
DB_HOST=platform-mysql
DB_NAME=devadmin_db
DB_USER=devadmin_user
DB_PASSWORD=
DB_PORT=3306

# ---------------------------------------------------------------------------
# REQUIRED — CORS & CSRF (Django 4.0+ requirement for production)
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=https://admin.logicbyroshan.in
CSRF_TRUSTED_ORIGINS=https://admin.logicbyroshan.in

# ---------------------------------------------------------------------------
# REQUIRED — HTTPS / Proxy Security
#
# SECURE_SSL_REDIRECT must be False when Django is behind Nginx/a reverse proxy.
# Nginx terminates SSL and forwards plain HTTP to Django inside Docker.
# If set to True, Django will enter an infinite redirect loop.
#
# Nginx must pass:  proxy_set_header X-Forwarded-Proto $scheme;
# (The existing scripts/nginx.conf already does this.)
# ---------------------------------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Start with a short HSTS duration. Increase to 31536000 after SSL is confirmed stable.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ---------------------------------------------------------------------------
# OPTIONAL — SMTP Email (leave USE_REAL_SMTP=False until email is configured)
# ---------------------------------------------------------------------------

USE_REAL_SMTP=False
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=DevAdmin <noreply@logicbyroshan.in>
