# ===========================================================================
# DevAdmin Backend — Production Docker Environment Configuration
# Copy this file to backend/.env and provide your secret values.
# NEVER commit the real .env file to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django Core Settings
# ---------------------------------------------------------------------------
DEBUG=False

# Generate a strong 50+ character secret key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_strong_random_secret_key_here

# Allowed host headers (comma-separated). Must include API and frontend domains.
ALLOWED_HOSTS=devadmin-api.logicbyroshan.in,devadmin.logicbyroshan.in,localhost,127.0.0.1,devadmin-backend

# ---------------------------------------------------------------------------
# Database (MySQL via external platform-mysql network)
# ---------------------------------------------------------------------------
USE_MYSQL=True
DB_HOST=platform-mysql
DB_NAME=devadmin_db
DB_USER=devadmin_user
DB_PASSWORD=your_secure_database_password
DB_PORT=3306

# ---------------------------------------------------------------------------
# CORS & CSRF Origins (Django 4.0+ / 5.0+)
# ---------------------------------------------------------------------------
# Allow requests from the production React frontend SPA
CORS_ALLOWED_ORIGINS=https://devadmin.logicbyroshan.in

# Trusted origins for state-modifying requests (PATCH/POST/DELETE)
CSRF_TRUSTED_ORIGINS=https://devadmin.logicbyroshan.in,https://devadmin-api.logicbyroshan.in

# ---------------------------------------------------------------------------
# HTTPS & Reverse Proxy Security (Cloudflare -> Host Nginx -> Docker)
# ---------------------------------------------------------------------------
# Keep SECURE_SSL_REDIRECT=False because Cloudflare/Host Nginx terminates SSL
# and forwards plain HTTP to Django inside Docker.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS Header (seconds). Recommended: 31536000 once HTTPS is verified stable.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ---------------------------------------------------------------------------
# Gunicorn Worker Concurrency (Lightweight VPS: 2 workers recommended)
# ---------------------------------------------------------------------------
WEB_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Email / SMTP Relay (Optional)
# ---------------------------------------------------------------------------
USE_REAL_SMTP=False
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=DevAdmin <noreply@logicbyroshan.in>
