# ==============================================================================
# DevAdmin Production Master Environment Template (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to backend/.env (or set variables in your CI/CD / secret manager):
#      cp .env.production.example backend/.env
# 2. Populate strong, unique credentials.
# 3. NEVER commit real production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Compose / Host Port Configuration
# ------------------------------------------------------------------------------
# Localhost reverse proxy ports (Host Nginx routes traffic here)
FRONTEND_PORT=8107
BACKEND_PORT=8108

# Frontend build-time API base URL
VITE_API_BASE_URL=https://devadmin-api.logicbyroshan.in

# ------------------------------------------------------------------------------
# 2. Django Core Production Settings
# ------------------------------------------------------------------------------
DEBUG=False

# Generate a strong 50+ character random secret key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-50-character-crypto-secure-secret-key

# Allowed Host headers (comma-separated, without http/https)
ALLOWED_HOSTS=devadmin-api.logicbyroshan.in,devadmin.logicbyroshan.in,localhost,127.0.0.1,devadmin-backend,backend

# ------------------------------------------------------------------------------
# 3. Production MySQL Database (via external platform-mysql network)
# ------------------------------------------------------------------------------
USE_MYSQL=True
DB_HOST=platform-mysql
DB_PORT=3306
DB_NAME=devadmin_db
DB_USER=devadmin_user
DB_PASSWORD=replace-with-your-strong-production-database-password
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# 4. CORS & CSRF Trusted Origins
# ------------------------------------------------------------------------------
# Frontend SPA origin permitted to make cross-origin API calls
CORS_ALLOWED_ORIGINS=https://devadmin.logicbyroshan.in

# Trusted origins for state-modifying requests (POST, PUT, PATCH, DELETE)
CSRF_TRUSTED_ORIGINS=https://devadmin.logicbyroshan.in,https://devadmin-api.logicbyroshan.in

# ------------------------------------------------------------------------------
# 5. HTTPS & Reverse Proxy Security (Cloudflare -> Host Nginx -> Docker)
# ------------------------------------------------------------------------------
# False because Host Nginx terminates SSL and forwards plain HTTP to container
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 6. Gunicorn Concurrency & Resource Limits (VPS: 2 workers recommended)
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 7. Optional SMTP Relay for Contact Inquiries & Password Resets
# ------------------------------------------------------------------------------
USE_REAL_SMTP=False
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@logicbyroshan.in
# EMAIL_HOST_PASSWORD=your-secure-app-password
# DEFAULT_FROM_EMAIL=DevAdmin <noreply@logicbyroshan.in>
